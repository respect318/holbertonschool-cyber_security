{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SIEMLogBucketRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::meddefense-siemlog-prod",
        "arn:aws:s3:::meddefense-siemlog-prod/*"
      ]
    },
    {
      "Sid": "LambdaCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:123456789012:log-group:/aws/lambda/siem-log-reader:*"
    }
  ]
}
